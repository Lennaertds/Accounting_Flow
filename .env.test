# .env.test

# --- Database Configuratie ---
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=superveiligtijdelijkwachtwoord
TEST_DB_NAME=boekhoud_test_db
CLI_DATABASE_URL=postgresql://postgres:superveiligtijdelijkwachtwoord@localhost:5433/boekhoud_test_db
DATABASE_URL=postgresql://postgres:superveiligtijdelijkwachtwoord@localhost:5433/boekhoud_test_db

# --- Algemene configuratie ---
NODE_ENV=testing
PORT=3000
DB_RUN_MIGRATIONS=true

# --- JWT Auth configuration ---
JWT_SECRET=test-secret-key-123
AUTH_JWT_SECRET=test-secret-key-123
AUTH_JWT_AUDIENCE=accounting-app-test
AUTH_JWT_ISSUER=accounting-api-test
JWT_EXPIRATION=3600
AUTH_MAX_DELAY=0 

# --- Argon2 Hashing (Snelheid is key in tests!) ---
# We zetten deze op de absolute minima voor test-snelheid
ARGON_HASH_LENGTH=32
ARGON_TIME_COST=1
ARGON_MEMORY_COST=1024
ARGON_PARALLELISM=1

# Logging
LOG_DISABLED=true